# EnergyModeler environment. Copy to .env and fill in. NEVER commit real secrets.
# All keys are OPTIONAL for the beta — without them the platform runs fully
# offline using bundled data and the labeled analytical-estimate engine.

# --- Upstream data sources ---
# NREL Developer Network key (PVWatts solar + OpenEI URDB utility rates).
# Free: https://developer.nrel.gov/signup/
NREL_API_KEY=

# LBNL IGSDB token (live glazing optical data). Request from LBNL.
IGSDB_API_TOKEN=

# --- EnergyPlus engine ---
# Directory containing the `energyplus` binary. When set (and DOE prototype IDFs
# are present) the real EnergyPlus pipeline runs instead of the estimate.
ENERGYPLUS_DIR=
PROTOTYPES_DIR=/opt/energyplus/prototypes
EGRID_DATA_DIR=

# --- Persistence / storage ---
# Beta default is SQLite. For production use a Supabase/Postgres URL:
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./energy_modeler.db
STORAGE_DIR=./storage

# --- Async worker (optional, profile: full) ---
REDIS_URL=redis://localhost:6379/0
