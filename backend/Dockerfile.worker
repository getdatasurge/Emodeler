# EnergyPlus worker image (spec Ch 9.5). Built on the official EnergyPlus
# container so the real IDF pipeline runs; falls back to the labeled estimate
# only if prototypes are missing.
#
# Pinned to 22.1.0 to match the bundled DOE prototype IDF version (energycodes.gov
# STD2019); a newer binary rejects their shifted object fields. Bump only alongside
# the prototypes (or after IDFVersionUpdater).
FROM nrel/energyplus:22.1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libxml2 libxslt1.1 \
    libpango-1.0-0 libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bundle DOE Commercial Prototype IDFs here at build time (energycodes.gov),
# organized as prototypes/<std>/<BuildingType>/<...>.idf (spec Ch 5.3).
# COPY prototypes/ /opt/energyplus/prototypes/

COPY requirements-worker.txt requirements.txt ./
# Upgrade pip first: base image ships pip 22.0.2 (predates --break-system-packages).
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir --break-system-packages -r requirements-worker.txt

COPY . /app/

# The `energyplus` binary + Energy+.idd are auto-detected from PATH (the nrel
# image installs them under a hash-suffixed dir), so we don't pin ENERGYPLUS_DIR.
ENV PROTOTYPES_DIR=/opt/energyplus/prototypes \
    EGRID_DATA_DIR=/app/energy_modeler/data

CMD ["celery", "-A", "workers.eplus_worker", "worker", "--loglevel=info", "--concurrency=1"]
