# All-in-one image (spec Ch 9.5) for a single-service bid-grade deploy: the
# EnergyPlus binary + the FastAPI app in one container, running calc jobs inline
# (no separate worker/Redis needed). Point a Render web service at this Dockerfile
# and attach a persistent disk at /data. For high throughput, split into the
# api + worker + redis stack (docker-compose --profile full) instead.
#
# EnergyPlus is pinned to 22.1.0 to match the bundled DOE prototype IDFs
# (energycodes.gov STD2019); a newer binary parses their shifted object fields
# positionally and rejects the input. The official nrel:22.1.0 image is Ubuntu
# 18.04 / Python 3.6 — too old to run the app — so we copy just the EnergyPlus
# install into an Ubuntu 22.04 / Python 3.10 stage (the binary is built against
# glibc 2.27 and runs fine on 22.04's newer glibc). Bump both together.
FROM nrel/energyplus:22.1.0 AS eplus

FROM ubuntu:22.04

# EnergyPlus 22.1.0 install dir (energyplus binary + Energy+.idd + datasets),
# self-contained; found via PATH and the /usr/local/EnergyPlus* auto-detect glob.
COPY --from=eplus /EnergyPlus-22.1.0-ed759b17ee-Linux-Ubuntu18.04-x86_64 \
                  /usr/local/EnergyPlus-22.1.0-ed759b17ee-Linux-Ubuntu18.04-x86_64
ENV PATH=/usr/local/EnergyPlus-22.1.0-ed759b17ee-Linux-Ubuntu18.04-x86_64:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libxml2 libxslt1.1 \
    libpango-1.0-0 libpangoft2-1.0-0 \
    libcairo2 libgdk-pixbuf-2.0-0 shared-mime-info \
    libgomp1 libstdc++6 libx11-6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-worker.txt requirements.txt ./
# Upgrade pip first: jammy ships pip 22.0.2, which predates --break-system-packages
# (added in pip 23.0).
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir --break-system-packages -r requirements-worker.txt

COPY . /app/

# Prototypes + weather + SQLite + audit bundles live on the persistent /data disk
# so they survive redeploys. The energyplus binary + Energy+.idd are on PATH (and
# also auto-detected under /usr/local/EnergyPlus*).
ENV PROTOTYPES_DIR=/data/prototypes \
    EGRID_DATA_DIR=/app/energy_modeler/data \
    STORAGE_DIR=/data/storage \
    DATABASE_URL=sqlite:////data/energy_modeler.db

EXPOSE 8000
# Bind the platform $PORT (Render injects it); inline jobs use the real engine
# because the EnergyPlus binary is present.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
